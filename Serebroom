let state = { tab:'catalog', activeCat:null, showCats:true, cart:[], fav:[], current:null };

function fmt(n){ return n.toLocaleString('ru-RU')+' ₽'; }

function renderCatGrid(){
  const grid = document.getElementById('catGrid');
  grid.innerHTML = CATS.map(c=>`
    <div class="cat-tile" onclick="selectCat('${c.id}')">
      <div class="wm"><svg viewBox="0 0 24 24">${ICONS[c.id==='new'?'whale':c.id]}</svg></div>
      <svg class="chev" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
      <span class="label">${c.name}</span>
    </div>`).join('');
}
function showCategories(){
  state.showCats = true;
  document.getElementById('catalogHome').style.display = '';
  document.getElementById('catalogList').style.display = 'none';
  document.getElementById('backRow').style.display = 'none';
}
function selectCat(id){
  state.activeCat = id; state.showCats = false; state.tab='catalog';
  document.querySelectorAll('nav.bottom button').forEach(b=>b.classList.remove('active'));
  document.querySelector(`nav.bottom button[data-tab="catalog"]`).classList.add('active');
  document.getElementById('catalogHome').style.display = 'none';
  document.getElementById('catalogList').style.display = '';
  document.getElementById('backRow').style.display = 'flex';
  renderGrid();
}
function setTab(tab){
  state.tab = tab;
  document.querySelectorAll('nav.bottom button').forEach(b=>b.classList.remove('active'));
  document.querySelector(`nav.bottom button[data-tab="${tab}"]`).classList.add('active');
  if(tab==='catalog'){ showCategories(); }
  else{
    document.getElementById('catalogHome').style.display = 'none';
    document.getElementById('catalogList').style.display = '';
    document.getElementById('backRow').style.display = 'none';
    renderGrid();
  }
}
function renderGrid(){
  const title = document.getElementById('gridTitle');
  let list;
  if(state.tab==='fav'){
    title.textContent = 'Избранное';
    list = PRODUCTS.filter(p=>state.fav.includes(p.id));
  } else if(state.activeCat==='new'){
    title.textContent = 'Новинки';
    list = PRODUCTS.filter(p=>p.new);
  } else {
    title.textContent = CATS.find(c=>c.id===state.activeCat)?.name || 'Каталог';
    list = PRODUCTS.filter(p=>p.cat===state.activeCat);
  }
  document.getElementById('gridCount').textContent = list.length ? list.length+' изд.' : '';
  const grid = document.getElementById('grid');
  if(!list.length){
    grid.innerHTML = `<div class="cart-empty" style="grid-column:1/3;">${state.tab==='fav'?'Пока пусто. Отмечайте украшения сердечком.':'В этой категории пока нет изделий.'}</div>`;
    return;
  }
  grid.innerHTML = list.map(p=>`
    <div class="card" onclick="openProduct(${p.id})">
      <div class="thumb"><svg viewBox="0 0 24 24">${ICONS[p.icon]}</svg></div>
      <div class="info">
        <p class="name">${p.name}</p>
        <div class="meta">
          <span class="price">${fmt(p.price)}</span>
          <button class="fav-btn ${state.fav.includes(p.id)?'on':''}" onclick="event.stopPropagation();toggleFav(${p.id})">
            <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-9.5-8.8C.6 7.4 2.6 4 6.2 4c2 0 3.6 1.1 4.4 2.6C11.4 5.1 13 4 15 4c3.6 0 5.6 3.4 3.7 7.2C19 15.6 12 20 12 20z"/></svg>
          </button>
        </div>
      </div>
    </div>`).join('');
}
function toggleFav(id){
  const i = state.fav.indexOf(id);
  if(i>-1) state.fav.splice(i,1); else state.fav.push(id);
  renderGrid();
  if(state.current && state.current.id===id) updateFavBtn();
}
function toggleFavCurrent(){ if(state.current) toggleFav(state.current.id); }
function updateFavBtn(){
  const on = state.fav.includes(state.current.id);
  document.getElementById('pdFav').textContent = on ? 'В избранном ✓' : 'В избранное';
}

/* ---------- Sheets ---------- */
function showSheet(id){
  document.getElementById('overlay').classList.add('show');
  document.getElementById(id).classList.add('show');
}
function closeAll(){
  document.getElementById('overlay').classList.remove('show');
  document.querySelectorAll('.sheet').forEach(s=>s.classList.remove('show'));
}
function openProduct(id){
  const p = PRODUCTS.find(x=>x.id===id);
  state.current = p;
  document.getElementById('pdHero').innerHTML = `<svg viewBox="0 0 24 24">${ICONS[p.icon]}</svg>`;
  document.getElementById('pdName').textContent = p.name;
  document.getElementById('pdPrice').textContent = fmt(p.price);
  document.getElementById('pdDesc').textContent = p.desc;
  const stoneRow = document.getElementById('pdStoneRow');
  if(p.stone){ stoneRow.style.display='flex'; document.getElementById('pdStone').textContent = p.stone; }
  else stoneRow.style.display='none';
  updateFavBtn();
  showSheet('sheetProduct');
}
function addToCartCurrent(){
  if(!state.current) return;
  state.cart.push(state.current.id);
  updateCartBadge();
  showToast('Добавлено в корзину');
}
function updateCartBadge(){
  const b = document.getElementById('cartBadge');
  if(state.cart.length){ b.style.display='flex'; b.textContent = state.cart.length; }
  else b.style.display='none';
}
function openCart(){
  const list = document.getElementById('cartList');
  const summary = document.getElementById('cartSummary');
  if(!state.cart.length){
    list.innerHTML = `<div class="cart-empty">Корзина пуста. Загляните в каталог — там ждёт хвост кита.</div>`;
    summary.innerHTML = '';
  } else {
    let total = 0;
    list.innerHTML = state.cart.map((id,idx)=>{
      const p = PRODUCTS.find(x=>x.id===id); total += p.price;
      return `<div class="cart-row">
        <div class="thumb"><svg viewBox="0 0 24 24">${ICONS[p.icon]}</svg></div>
        <div class="cinfo"><p class="name">${p.name}</p><span class="price">${fmt(p.price)}</span></div>
        <button class="remove" onclick="removeFromCart(${idx})">Убрать</button>
      </div>`;
    }).join('');
    summary.innerHTML = `
      <div class="cart-summary">
        <div class="row"><span>Доставка</span><span>от 300 ₽ / бесплатно от 15 000 ₽</span></div>
        <div class="total"><span>Итого</span><span>${fmt(total)}</span></div>
      </div>
      <div style="padding:0 20px 6px;"><button class="btn btn-primary" onclick="checkout()">Оформить заказ</button></div>`;
  }
  showSheet('sheetCart');
}
function removeFromCart(idx){ state.cart.splice(idx,1); updateCartBadge(); openCart(); }
function checkout(){
  closeAll();
  const items = state.cart.map(id=>PRODUCTS.find(p=>p.id===id).name).join(', ');
  const text = encodeURIComponent(`Здравствуйте! Хочу заказать: ${items}`);
  document.getElementById('waLink').href = `https://t.me/serebroomru?text=${text}`;
  setTimeout(()=>showSheet('sheetContact'), 260);
}
function openContact(){ showSheet('sheetContact'); }
function openIndividual(){
  document.getElementById('waLink').href = `https://t.me/serebroomru?text=${encodeURIComponent('Здравствуйте! Хочу обсудить индивидуальный заказ.')}`;
  showSheet('sheetContact');
}
function openAbout(){ showSheet('sheetAbout'); }
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(window._toastTimer);
  window._toastTimer = setTimeout(()=>t.classList.remove('show'), 1600);
}

renderCatGrid();
showCategories();
</script>
</body>
</html>
