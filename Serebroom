<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SEREBROOM</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#ffffff; --surface:#ffffff; --surface2:#eeeeee;
  --line:rgba(20,20,20,.12);
  --text:#141414; --text-dim:#5b6672;
  --silver:#6b6b6b; --accent:#141414; --accent-soft:rgba(20,20,20,.06);
  --tile:#8a8a8a;
  --danger:#b8654f;
  color-scheme: light;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
:root:not([data-theme="light"]){ }
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){ } }
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px); height:100%;}
body{
  margin:0; height:100%; background:var(--bg); color:var(--text);
  font-family:'Inter',sans-serif; -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
h1,h2,h3,.serif{font-family:'Manrope',sans-serif;font-weight:800;letter-spacing:-.01em;}
::-webkit-scrollbar{display:none}

/* ---------- Frame ---------- */
.app{max-width:480px;margin:0 auto;min-height:100%;display:flex;flex-direction:column;position:relative;background:var(--bg);}

/* ---------- Header ---------- */
header{
  padding:calc(18px + env(safe-area-inset-top,0px)) 20px 14px;
  display:flex;align-items:center;justify-content:space-between;
  border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--bg);z-index:20;
}
.logo{display:flex;align-items:center;gap:10px;}
.logo img{width:38px;height:38px;border-radius:50%;display:block;}
.logo span{font-size:16px;letter-spacing:.02em;font-weight:800;font-family:'Manrope',sans-serif;}
.icon-btn{background:none;border:none;color:var(--text);position:relative;padding:6px;cursor:pointer;}
.icon-btn svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.4;}
.badge{position:absolute;top:0;right:0;background:var(--accent);color:var(--bg);font-size:10px;font-weight:600;border-radius:20px;min-width:15px;height:15px;display:flex;align-items:center;justify-content:center;padding:0 3px;}

/* ---------- Hero ---------- */
.hero{padding:26px 20px 8px;}
.hero .eyebrow{color:var(--text-dim);font-size:12.5px;margin-bottom:10px;font-weight:600;}
.hero .rule{width:40px;height:2px;background:var(--text);margin:10px 0 14px;}
.hero h1{font-size:30px;line-height:1.18;margin:0 0 4px;font-weight:800;}
.hero p{color:var(--text-dim);font-size:14px;line-height:1.6;margin:0 0 16px;max-width:36ch;}
.hero .tail-badge{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:100px;padding:6px 14px 6px 8px;font-size:12.5px;color:var(--text-dim);}
.hero .tail-badge .dot{width:7px;height:7px;border-radius:50%;background:var(--accent);}

/* ---------- Category tiles (catalog home) ---------- */
.cat-head{display:flex;align-items:baseline;justify-content:space-between;padding:20px 20px 12px;}
.cat-head h2{font-size:20px;margin:0;font-weight:800;}
.cat-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:0 20px 8px;}
.cat-tile{position:relative;aspect-ratio:1.35/1;border-radius:14px;overflow:hidden;cursor:pointer;
  background:var(--tile);display:flex;align-items:flex-end;padding:12px;color:#fff;transition:transform .15s;}
.cat-tile:active{transform:scale(.96);}
.cat-tile .wm{position:absolute;top:-8%;right:-8%;width:75%;height:75%;opacity:.28;pointer-events:none;}
.cat-tile .wm svg{width:100%;height:100%;stroke:#fff;fill:none;stroke-width:1;}
.cat-tile .label{position:relative;z-index:2;font-weight:700;font-size:13.5px;line-height:1.28;}
.cat-tile .chev{position:absolute;top:10px;right:10px;width:18px;height:18px;color:#fff;z-index:2;opacity:.9;}
.back-row{display:flex;align-items:center;gap:6px;padding:16px 20px 0;color:var(--text-dim);font-size:13px;cursor:pointer;}
.back-row svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.6;}

/* ---------- Grid ---------- */
.section-label{display:flex;align-items:baseline;justify-content:space-between;padding:14px 20px 10px;}
.section-label h2{font-size:20px;margin:0;font-weight:800;}
.section-label span{font-size:12px;color:var(--text-dim);}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:0 20px 10px;}
.card{background:var(--surface);border:1px solid var(--line);border-radius:2px;overflow:hidden;cursor:pointer;transition:transform .15s;}
.card:active{transform:scale(.97);}
.card .thumb{aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;background:var(--surface2);}
.card .thumb svg{width:52%;height:52%;stroke:var(--silver);fill:none;stroke-width:1.1;opacity:.92;}
.card .info{padding:11px 12px 13px;}
.card .name{font-size:13.5px;line-height:1.3;margin:0 0 4px;}
.card .meta{display:flex;align-items:center;justify-content:space-between;}
.card .price{font-size:14px;color:var(--text);font-weight:700;}
.fav-btn{background:none;border:none;color:var(--text-dim);cursor:pointer;padding:2px;}
.fav-btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.4;}
.fav-btn.on svg{fill:var(--accent);stroke:var(--accent);}

/* ---------- Bottom nav ---------- */
nav.bottom{
  position:sticky;bottom:0;display:flex;border-top:1px solid var(--line);background:var(--bg);
  padding:8px 6px calc(8px + env(safe-area-inset-bottom,0px));z-index:30;
}
nav.bottom button{flex:1;background:none;border:none;color:var(--text-dim);display:flex;flex-direction:column;align-items:center;gap:3px;font-size:10.5px;padding:4px;cursor:pointer;}
nav.bottom button svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.4;}
nav.bottom button.active{color:var(--text);}
nav.bottom button.active svg{stroke:var(--accent);}

/* ---------- Sheet (product / cart / contact) ---------- */
.overlay{position:fixed;inset:0;background:rgba(24,23,20,.4);opacity:0;pointer-events:none;transition:opacity .2s;z-index:40;}
.overlay.show{opacity:1;pointer-events:auto;}
.sheet{
  position:fixed;left:50%;bottom:0;transform:translate(-50%,100%);width:100%;max-width:480px;
  background:var(--bg);border-top:1px solid var(--line);border-radius:14px 14px 0 0;
  max-height:88vh;overflow-y:auto;transition:transform .28s cubic-bezier(.22,.9,.3,1);z-index:41;
  padding-bottom:calc(20px + env(safe-area-inset-bottom,0px));
}
.sheet.show{transform:translate(-50%,0);}
.sheet-handle{width:36px;height:4px;background:var(--line);border-radius:4px;margin:10px auto 4px;}
.sheet-close{position:absolute;top:14px;right:16px;background:none;border:none;color:var(--text-dim);cursor:pointer;}
.sheet-close svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.4;}

.pd-hero{aspect-ratio:1/1;max-height:280px;margin:6px 20px 0;background:radial-gradient(120% 90% at 30% 20%, rgba(63,97,105,.08), transparent 60%), var(--surface2);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;}
.pd-hero svg{width:44%;height:44%;stroke:var(--silver);fill:none;stroke-width:1;}
.pd-body{padding:18px 20px 4px;}
.pd-body h3{font-size:24px;margin:0 0 6px;font-weight:500;}
.pd-price{font-size:18px;color:var(--accent);margin:0 0 14px;}
.pd-desc{font-size:13.5px;color:var(--text-dim);line-height:1.6;margin:0 0 16px;}
.pd-specs{display:flex;flex-direction:column;gap:8px;font-size:12.5px;color:var(--text-dim);border-top:1px solid var(--line);padding:14px 0;margin-bottom:16px;}
.pd-specs div{display:flex;justify-content:space-between;}
.pd-specs b{color:var(--text);font-weight:500;}

.btn{width:100%;padding:14px;border-radius:2px;border:1px solid transparent;font-size:14px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;}
.btn-primary{background:var(--accent);color:var(--bg);}
.btn-primary:active{opacity:.85;}
.btn-ghost{background:none;border:1px solid var(--line);color:var(--text);}
.pd-actions{display:flex;gap:10px;padding:0 20px 6px;}
.pd-actions .btn{margin:0;}

.cart-row{display:flex;gap:12px;padding:14px 20px;border-bottom:1px solid var(--line);align-items:center;}
.cart-row .thumb{width:56px;height:56px;flex:0 0 auto;background:var(--surface2);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;}
.cart-row .thumb svg{width:60%;height:60%;stroke:var(--silver);fill:none;stroke-width:1.2;}
.cart-row .cinfo{flex:1;min-width:0;}
.cart-row .cinfo .name{font-size:13.5px;margin:0 0 4px;}
.cart-row .cinfo .price{font-size:13px;color:var(--accent);}
.cart-row .remove{background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:12px;padding:4px;}
.cart-empty{padding:60px 20px;text-align:center;color:var(--text-dim);font-size:13.5px;}
.cart-summary{padding:16px 20px 0;}
.cart-summary .row{display:flex;justify-content:space-between;font-size:13.5px;color:var(--text-dim);margin-bottom:6px;}
.cart-summary .total{display:flex;justify-content:space-between;font-size:18px;color:var(--text);margin:10px 0 16px;font-family:'Manrope',sans-serif;font-weight:800;}

.contact-list{padding:6px 20px 4px;display:flex;flex-direction:column;gap:10px;}
.contact-item{display:flex;align-items:center;gap:12px;border:1px solid var(--line);padding:13px 14px;border-radius:2px;text-decoration:none;color:var(--text);}
.contact-item svg{width:20px;height:20px;stroke:var(--accent);fill:none;stroke-width:1.4;flex:0 0 auto;}
.contact-item .t{font-size:13.5px;}
.contact-item .s{font-size:11.5px;color:var(--text-dim);}

.toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%) translateY(20px);background:var(--surface2);border:1px solid var(--line);color:var(--text);padding:10px 18px;border-radius:100px;font-size:13px;opacity:0;transition:.25s;z-index:60;}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
.about-body{padding:6px 20px 4px;font-size:13.5px;color:var(--text-dim);line-height:1.7;}
.about-body h3{color:var(--text);font-size:19px;margin:16px 0 6px;font-weight:500;}
.about-body .addr{color:var(--text);margin-top:4px;}
</style>
</head>
<body>
<div class="app">

  <header>
